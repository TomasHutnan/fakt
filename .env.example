# For compose.vps.yaml. Copy to .env next to it and fill in.

# The public domain. Caddy gets its certificate; the app's origin is https://<this>.
FAKT_DOMAIN=fakt.hutnan.dev

# Host folder for room snapshots, owned by uid 1000:
#   sudo install -d -o 1000 -g 1000 /home/deploy/data/fakt
FAKT_DATA_PATH=/home/deploy/data/fakt

# A commit (sha-1a2b3c4) to pin or roll back. Default: latest (newest main).
# FAKT_IMAGE_TAG=latest

# --- Limits (all optional; the values shown are the defaults) ---
# Rooms are kept in memory and anyone can create one, so everything is capped.

# Container caps. NODE heap stays below the memory limit.
# FAKT_MEM_LIMIT=256m
# FAKT_CPUS=0.5
# FAKT_HEAP_MB=160

# Rooms open at once, in total and per address.
# FAKT_MAX_ROOMS=200
# FAKT_ROOMS_PER_IP=3
# Rooms one address may create in 10 minutes (failed attempts count too).
# FAKT_CREATES_PER_10MIN=6

# Open connections in total and per address. A party on one Wi-Fi shares an
# address: 12 players plus big screens, with reconnects, fits well under 40.
# FAKT_MAX_CONNECTIONS=600
# FAKT_CONNECTIONS_PER_IP=40

# Memory for uploaded question packs. Identical packs are stored once, so all
# rooms playing the built-in packs share one copy (about 0.8 MB).
# FAKT_MAX_PACK_MB=12

# A game ends this long after the room was created or "Ešte jednu" started a new
# game. Idle rooms go sooner: 10 min with nobody connected, 20 min without activity.
# FAKT_ROOM_TTL_MINUTES=60
